node_modules/
# Local scratch from aligning the checkout's peers with the engine release
# (a workspace-local npm cache, since ~/.npm is outside the sandbox).
node_modules.bak/
.npm-cache/
# DSH STORE reviews the fixed Git Commit, so the built runtime files ship in
# git. `lib/` artifacts are committed explicitly with `git add -f`; the ignore
# stays so stray local rebuilds do not show up as noise. Source maps are
# deliberately outside both: nothing loads them, `files` keeps them out of the
# tarball, and they are the one tsdown output that does not rebuild
# byte-identically across machines, so tracking them only breaks the CI
# `git diff --exit-code -- lib/` guard.
lib/
*.tgz
.DS_Store
# 将可复用的 DSH 升级技能纳入版本控制；
# 其他本地代理临时文件仍忽略，Python 缓存继续由下方规则排除。
.agents/*
!.agents/
!.agents/skills/
.agents/skills/*
!.agents/skills/dsh-release-upgrade/
!.agents/skills/dsh-release-upgrade/**

# Local Open Design CLI state created inside this checkout. Local-only: never
# commit, never publish.
.opendesign/

# Maintainer-local release guide: never commit, never publish.
RELEASES.local.md
__pycache__/

# Maintainer-local issue reply drafts, same rule as RELEASES.local.md: they are
# unsent text, never commit and never publish.
issue-replies.local.md

# 本地 issue tracker（/setup-matt-pocock-skills）：spec 与票默认不入库
.scratch/

# /implement-spec 的临时 worktree（不入库）
.worktrees/

# worktree 里的 node_modules 是软链，node_modules/ 规则匹配不到软链，这里再挡一次
node_modules
