{
  "name": "@mars-sea/dsh-opendesign-provider",
  "version": "0.1.0",
  "description": "Unofficial DeepSeek Harness LLM provider plugin for Open Design: live model catalog, streaming with reasoning and tool calls, image input, a client-side output cap and a settings page.",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible",
        "0.2.1-rc.2": "compatible"
      },
      "dsh": "0.2.0-rc.2 || 0.2.1-rc.2"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "!lib/**/*.map",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "test:install": "node scripts/verify-isolated-install.mjs",
    "test:engine": "node scripts/verify-engine-load.mjs",
    "test:pack": "node scripts/verify-package-exports.mjs",
    "test:live": "node scripts/verify-live.mjs",
    "typecheck": "tsc --noEmit",
    "preview:ui": "node --import tsx scripts/preview-ui.mjs",
    "test": "node --import tsx --test tests/**/*.test.ts"
  },
  "engines": {
    "node": ">=22",
    "dsh": "0.2.0-rc.2 || 0.2.1-rc.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chee-0806/dsh-opendesign-provider.git"
  },
  "bugs": {
    "url": "https://github.com/Chee-0806/dsh-opendesign-provider/issues"
  },
  "homepage": "https://github.com/Chee-0806/dsh-opendesign-provider#readme",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "open-design",
    "opendesign",
    "llm",
    "adapter",
    "provider",
    "plugin",
    "bundle"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4 || ~4.0.5",
    "@deepseek-ai/dsh-api-remotes": "0.2.0-rc.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-attachment": "0.2.0-rc.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.0-rc.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-commands": "0.2.0-rc.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.2.0-rc.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.0-rc.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-timeout": "0.2.0-rc.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-web": "0.2.0-rc.2 || 0.2.1-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4 || ~3.18.5",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4 || ~4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-api-remotes": "0.2.0-rc.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-attachment": "0.2.0-rc.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.0-rc.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-commands": "0.2.0-rc.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.2.0-rc.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.0-rc.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.0-rc.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.0-rc.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-timeout": "0.2.0-rc.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-web": "0.2.0-rc.2 || 0.2.1-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4 || ~3.18.5",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.7",
    "happy-dom": "^21.0.4",
    "parse5": "8.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.2",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  }
}
